# Environment Configuration
# All variables are validated using Zod in lib/env.ts
# The application will fail to start if required variables are missing or invalid

# Application Environment
# Valid values: development | production | test
NODE_ENV=development

# Database (to be added in future PR)
# Required: Connection string for PostgreSQL database
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Authentication (to be added in future PR)
# Required: Clerk authentication keys
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
